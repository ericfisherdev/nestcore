package components

// NavPill renders a sidebar navigation pill. The active pill uses the shared
// primary-tint background and primary-deep text (see ui/css/theme.css); an
// inactive pill is quiet until hovered.
templ NavPill(label, href string, active bool) {
	<a
		href={ href }
		class={ "block rounded-control px-3 py-2 font-medium transition-colors", navPillClass(active) }
		if active {
			aria-current="page"
		}
	>
		{ label }
	</a>
}

// navPillClass maps the active state to its Tailwind classes.
func navPillClass(active bool) string {
	if active {
		return "bg-primary-tint text-primary-deep"
	}
	return "text-text-secondary hover:bg-sidebar-accent"
}
